# Database (Neon PostgreSQL - Free tier available)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Google AI (Gemini API - Get key from https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your-gemini-api-key

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-min-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App Settings
DEBUG=false
CORS_ORIGINS=http://localhost:3000

# Redis (Upstash - Free tier available)
# For Upstash, use rediss:// (with SSL)
REDIS_URL=rediss://default:password@hostname.upstash.io:6379

# Scheduler (set to false to disable background tasks)
USE_SCHEDULER=true

# Follow-up Settings (in hours)
FOLLOWUP_CHECK_INTERVAL_HOURS=4
FOLLOWUP_INACTIVITY_HOURS=24
FOLLOWUP_PLAN_CHECKIN_HOURS=48
